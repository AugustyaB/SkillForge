{
  "name": "skillforge",
  "displayName": "SkillForge",
  "description": "Cross-IDE skill suggestion engine for developers",
  "version": "0.1.0",
  "publisher": "skillforge",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:rust",
    "onLanguage:go",
    "onLanguage:java",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onView:skillforge.contextView",
    "onView:skillforge.quickActionsView",
    "onView:skillforge.recentQueriesView",
    "onCommand:skillforge.testConnection",
    "onCommand:skillforge.suggest",
    "onCommand:skillforge.selectScope",
    "onCommand:skillforge.rescanWorkspace",
    "onCommand:skillforge.suggestForCurrentFile",
    "onCommand:skillforge.runInstallCommand",
    "onCommand:skillforge.clearRecentQueries",
    "onCommand:skillforge.showCanvas"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skillforge-activitybar",
          "title": "SkillForge",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "skillforge-activitybar": [
        {
          "id": "skillforge.contextView",
          "name": "Context & Stack"
        },
        {
          "id": "skillforge.quickActionsView",
          "name": "Quick Actions"
        },
        {
          "id": "skillforge.recentQueriesView",
          "name": "Recent Discoveries"
        }
      ]
    },
    "commands": [
      {
        "command": "skillforge.testConnection",
        "title": "SkillForge: Test Server Connection",
        "category": "SkillForge"
      },
      {
        "command": "skillforge.suggest",
        "title": "SkillForge: Suggest Skills for My Idea",
        "category": "SkillForge"
      },
      {
        "command": "skillforge.selectScope",
        "title": "Select Context Scope",
        "category": "SkillForge",
        "icon": "$(folder)"
      },
      {
        "command": "skillforge.rescanWorkspace",
        "title": "Re-scan Project Stack",
        "category": "SkillForge",
        "icon": "$(refresh)"
      },
      {
        "command": "skillforge.suggestForCurrentFile",
        "title": "SkillForge: Suggest Skills for Active File",
        "category": "SkillForge",
        "icon": "$(sparkle)"
      },
      {
        "command": "skillforge.runInstallCommand",
        "title": "SkillForge: Run Install Command in Terminal",
        "category": "SkillForge"
      },
      {
        "command": "skillforge.clearRecentQueries",
        "title": "Clear Discoveries History",
        "category": "SkillForge",
        "icon": "$(clear-all)"
      },
      {
        "command": "skillforge.showCanvas",
        "title": "Open Suggestion Canvas",
        "category": "SkillForge",
        "icon": "$(layout)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skillforge.selectScope",
          "when": "view == skillforge.contextView",
          "group": "navigation@1"
        },
        {
          "command": "skillforge.rescanWorkspace",
          "when": "view == skillforge.contextView",
          "group": "navigation@2"
        },
        {
          "command": "skillforge.showCanvas",
          "when": "view == skillforge.contextView",
          "group": "navigation@3"
        },
        {
          "command": "skillforge.clearRecentQueries",
          "when": "view == skillforge.recentQueriesView",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "SkillForge",
      "properties": {
        "skillforge.maxResults": {
          "type": "number",
          "default": 5,
          "description": "Maximum number of skill suggestions to display."
        },
        "skillforge.defaultDifficulty": {
          "type": "string",
          "enum": ["all", "beginner", "intermediate", "advanced"],
          "default": "all",
          "description": "Default difficulty tier for skill recommendations."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@skillforge/shared": "workspace:*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/vscode": "^1.85.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
