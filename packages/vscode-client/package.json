{
  "name": "skillforge",
  "displayName": "SkillForge",
  "description": "Cross-IDE developer skill discovery engine: map natural language ideas to vetted libraries, frameworks, and architecture patterns",
  "version": "0.1.1",
  "publisher": "skillforge",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AugustyaB/SkillForge"
  },
  "bugs": {
    "url": "https://github.com/AugustyaB/SkillForge/issues"
  },
  "homepage": "https://github.com/AugustyaB/SkillForge#readme",
  "keywords": [
    "skills",
    "developer-tools",
    "libraries",
    "dependencies",
    "architecture",
    "recommendation",
    "discovery",
    "frameworks"
  ],
  "categories": [
    "Programming Languages",
    "Education",
    "AI"
  ],
  "galleryBanner": {
    "color": "#18181b",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:rust",
    "onLanguage:go",
    "onLanguage:java",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onView:skillforge.contextView",
    "onView:skillforge.quickActionsView",
    "onView:skillforge.commandsView",
    "onView:skillforge.recentQueriesView",
    "onView:skillforge.bookmarksView",
    "onCommand:skillforge.testConnection",
    "onCommand:skillforge.suggest",
    "onCommand:skillforge.selectScope",
    "onCommand:skillforge.rescanWorkspace",
    "onCommand:skillforge.suggestForCurrentFile",
    "onCommand:skillforge.runInstallCommand",
    "onCommand:skillforge.clearRecentQueries",
    "onCommand:skillforge.showCanvas",
    "onCommand:skillforge.setApiKey",
    "onCommand:skillforge.clearApiKey",
    "onCommand:skillforge.configureProvider",
    "onCommand:skillforge.configureModel",
    "onCommand:skillforge.toggleBookmark",
    "onCommand:skillforge.clearBookmarks",
    "onCommand:skillforge.compareSkills",
    "onCommand:skillforge.generateAgentSkill",
    "onCommand:skillforge.openWalkthrough"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skillforge-activitybar",
          "title": "SkillForge",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "skillforge-activitybar": [
        {
          "id": "skillforge.contextView",
          "name": "Context & Stack"
        },
        {
          "id": "skillforge.quickActionsView",
          "name": "Quick Actions"
        },
        {
          "id": "skillforge.commandsView",
          "name": "All SkillForge Commands"
        },
        {
          "id": "skillforge.recentQueriesView",
          "name": "Recent Discoveries"
        },
        {
          "id": "skillforge.bookmarksView",
          "name": "Bookmarked Tools",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "skillforge.testConnection",
        "title": "Check Offline Engine Status",
        "category": "SkillForge"
      },
      {
        "command": "skillforge.suggest",
        "title": "Find Libraries for Idea",
        "category": "SkillForge",
        "icon": "$(sparkle)"
      },
      {
        "command": "skillforge.selectScope",
        "title": "Choose Project Folder Scope",
        "category": "SkillForge",
        "icon": "$(folder)"
      },
      {
        "command": "skillforge.rescanWorkspace",
        "title": "Refresh Installed Packages",
        "category": "SkillForge",
        "icon": "$(refresh)"
      },
      {
        "command": "skillforge.suggestForCurrentFile",
        "title": "Suggest for Current File",
        "category": "SkillForge",
        "icon": "$(sparkle)"
      },
      {
        "command": "skillforge.runInstallCommand",
        "title": "Install Package in Terminal",
        "category": "SkillForge"
      },
      {
        "command": "skillforge.clearRecentQueries",
        "title": "Clear Search History",
        "category": "SkillForge",
        "icon": "$(clear-all)"
      },
      {
        "command": "skillforge.showCanvas",
        "title": "Open Results Dashboard",
        "category": "SkillForge",
        "icon": "$(layout)"
      },
      {
        "command": "skillforge.setApiKey",
        "title": "Save AI API Key (Optional)",
        "category": "SkillForge",
        "icon": "$(key)"
      },
      {
        "command": "skillforge.clearApiKey",
        "title": "Remove Saved API Key",
        "category": "SkillForge"
      },
      {
        "command": "skillforge.configureProvider",
        "title": "Switch Search Engine Mode (Offline / Cloud AI)",
        "category": "SkillForge",
        "icon": "$(settings-gear)"
      },
      {
        "command": "skillforge.toggleBookmark",
        "title": "Manage Saved Bookmarks",
        "category": "SkillForge",
        "icon": "$(bookmark)"
      },
      {
        "command": "skillforge.clearBookmarks",
        "title": "Clear All Bookmarks",
        "category": "SkillForge",
        "icon": "$(clear-all)"
      },
      {
        "command": "skillforge.compareSkills",
        "title": "Compare Libraries Side-by-Side",
        "category": "SkillForge",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "skillforge.generateAgentSkill",
        "title": "Create AI Rules File (Guide AI on a Library)",
        "category": "SkillForge",
        "icon": "$(robot)"
      },
      {
        "command": "skillforge.openWalkthrough",
        "title": "Open Beginner Guide",
        "category": "SkillForge",
        "icon": "$(mortar-board)"
      },
      {
        "command": "skillforge.configureModel",
        "title": "Configure AI Model (Free, Paid & Custom)",
        "category": "SkillForge",
        "icon": "$(sparkle)"
      }
    ],
    "keybindings": [
      {
        "command": "skillforge.suggest",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "skillforge.suggestForCurrentFile",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "skillforge.suggestForCurrentFile",
          "group": "navigation@10"
        }
      ],
      "view/title": [
        {
          "command": "skillforge.selectScope",
          "when": "view == skillforge.contextView",
          "group": "navigation@1"
        },
        {
          "command": "skillforge.rescanWorkspace",
          "when": "view == skillforge.contextView",
          "group": "navigation@2"
        },
        {
          "command": "skillforge.showCanvas",
          "when": "view == skillforge.contextView",
          "group": "navigation@3"
        },
        {
          "command": "skillforge.openWalkthrough",
          "when": "view == skillforge.contextView",
          "group": "navigation@4"
        },
        {
          "command": "skillforge.suggest",
          "when": "view == skillforge.quickActionsView",
          "group": "navigation@1"
        },
        {
          "command": "skillforge.showCanvas",
          "when": "view == skillforge.quickActionsView",
          "group": "navigation@2"
        },
        {
          "command": "skillforge.clearRecentQueries",
          "when": "view == skillforge.recentQueriesView",
          "group": "navigation@1"
        },
        {
          "command": "skillforge.compareSkills",
          "when": "view == skillforge.bookmarksView",
          "group": "navigation@1"
        },
        {
          "command": "skillforge.clearBookmarks",
          "when": "view == skillforge.bookmarksView",
          "group": "navigation@2"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "skillforge.walkthrough",
        "title": "Get Started with SkillForge",
        "description": "Learn how to discover, evaluate, and compare tools and libraries right from your code.",
        "steps": [
          {
            "id": "welcome",
            "title": "Welcome to SkillForge",
            "description": "Map natural language ideas to 360+ vetted libraries, frameworks, and AI agent directives — 100% offline by default.\n[Suggest Skills for My Idea](command:skillforge.suggest)",
            "media": {
              "markdown": "walkthrough/welcome.md"
            }
          },
          {
            "id": "scoping",
            "title": "Scope Your Context",
            "description": "Target the entire workspace, a specific monorepo package, or the active file so recommendations match your stack.\n[Select Context Scope](command:skillforge.selectScope)",
            "media": {
              "markdown": "walkthrough/scoping.md"
            }
          },
          {
            "id": "triggers",
            "title": "1-Click & Inline Triggers",
            "description": "Click $(sparkle) SkillForge in the bottom status bar, press Ctrl+Alt+S, or write // skillforge: comments in your code.\n[Suggest for Active File](command:skillforge.suggestForCurrentFile)",
            "media": {
              "markdown": "walkthrough/triggers.md"
            }
          },
          {
            "id": "comparison",
            "title": "Side-by-Side Tool Comparison",
            "description": "Compare libraries head-to-head across registry health, architectural caveats, and strengths.\n[Compare Libraries Side-by-Side](command:skillforge.compareSkills)",
            "media": {
              "markdown": "walkthrough/comparison.md"
            }
          },
          {
            "id": "privacy",
            "title": "Agent Directives & Privacy",
            "description": "Generate SKILL.md or .mdc agent rules with 1 click, or optionally configure BYOK AI providers.\n[Generate Agent Skill Directive](command:skillforge.generateAgentSkill)",
            "media": {
              "markdown": "walkthrough/privacy.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "SkillForge",
      "properties": {
        "skillforge.provider": {
          "type": "string",
          "enum": ["local", "openai", "gemini"],
          "default": "local",
          "description": "Suggestion provider. Defaults to 'local' (100% offline, zero code transmitted). Enable 'openai' or 'gemini' for BYOK AI enrichment (only your query string is sent; source code is never transmitted)."
        },
        "skillforge.maxResults": {
          "type": "number",
          "default": 5,
          "description": "Maximum number of skill suggestions to display."
        },
        "skillforge.defaultDifficulty": {
          "type": "string",
          "enum": ["all", "beginner", "intermediate", "advanced"],
          "default": "all",
          "description": "Default difficulty tier for skill recommendations."
        },
        "skillforge.openai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "OpenAI model to use for BYOK discovery. Accepts free/base tiers (e.g. gpt-4o-mini), paid flagships (e.g. gpt-4o), reasoning models (e.g. o3-mini, o1), or any custom endpoint model name."
        },
        "skillforge.openai.endpoint": {
          "type": "string",
          "default": "",
          "description": "Custom OpenAI-compatible API endpoint (defaults to https://api.openai.com/v1/chat/completions)."
        },
        "skillforge.gemini.model": {
          "type": "string",
          "default": "gemini-2.0-flash",
          "description": "Google Gemini model to use for BYOK discovery. Accepts free/base tiers (e.g. gemini-2.0-flash), paid reasoning models (e.g. gemini-1.5-pro, gemini-2.5-pro), or any custom model ID."
        },
        "skillforge.gemini.endpoint": {
          "type": "string",
          "default": "",
          "description": "Custom Google Gemini API endpoint."
        },
        "skillforge.timeoutMs": {
          "type": "number",
          "default": 4000,
          "description": "Timeout in milliseconds for BYOK cloud AI requests before falling back to the offline catalog."
        }
      }
    }
  },
  "scripts": {
    "copy-docs": "node -e \"const fs = require('fs'); fs.copyFileSync('../../CHANGELOG.md', 'CHANGELOG.md'); fs.copyFileSync('../../NOTICE', 'NOTICE');\"",
    "compile": "tsc -b",
    "bundle": "node esbuild.mjs",
    "bundle:prod": "node esbuild.mjs --production",
    "build": "pnpm run copy-docs && tsc -b && node esbuild.mjs --production",
    "package": "pnpm run copy-docs && vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@skillforge/shared": "workspace:*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/vscode": "^1.85.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
