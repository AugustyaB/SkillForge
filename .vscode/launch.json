{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run SkillForge Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-client"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/vscode-client/dist/**/*.js"
      ],
      "preLaunchTask": "build:all"
    }
  ]
}
